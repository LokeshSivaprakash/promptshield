# Copy to .env and fill in as needed.

# 'mock' (default) needs no API key and is what tests/demo use.
# 'openai' makes real calls -- also works against Azure OpenAI or any
# OpenAI-compatible endpoint via OPENAI_BASE_URL.
PROMPTSHIELD_BACKEND=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
PROMPTSHIELD_MODEL=gpt-4o-mini

# Structured audit log -- omit to log to stdout only.
PROMPTSHIELD_AUDIT_LOG_PATH=

# In-memory rate limiter (per-instance; see app/rate_limit.py roadmap note).
PROMPTSHIELD_RATE_LIMIT=60
PROMPTSHIELD_RATE_WINDOW_SECONDS=60
